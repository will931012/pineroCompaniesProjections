# Copy to .env for local development. Never commit .env.
# Every value below is either a safe local default or intentionally empty.

# --- Local infrastructure -------------------------------------------------
POSTGRES_PASSWORD=local-development-only
# Change these if the ports are taken on your machine.
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Web ------------------------------------------------------------------
# Public URL of the web app; unsafe requests from other origins are rejected.
FRONTEND_URL=http://localhost:3000

# --- Authentication -------------------------------------------------------
# Password sign-in works out of the box. Create the first admin with:
#   docker compose exec api python -m app.cli create-user --email you@example.com --name "You" --role admin
AUTH_ALLOW_REGISTRATION=true
# Optional single sign-on (any OIDC provider). Register this redirect URI:
#   http://localhost:3000/api/v1/auth/oidc/callback
AUTH_SECRET=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Data providers -------------------------------------------------------
# SEC EDGAR is free but requires a User-Agent that identifies you, e.g.
#   SEC_USER_AGENT="Your Name your.email@example.com"
# See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=
# Market data: currently supported adapter is `tiingo`
# (API token from https://www.tiingo.com/account/api/token).
MARKET_DATA_PROVIDER=
TIINGO_API_KEY=
# Macro data (Phase 6): free key from https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# CUSIP -> ticker for 13F holdings; optional (raises OpenFIGI's limits): https://www.openfigi.com/api
OPENFIGI_API_KEY=

# --- Observability --------------------------------------------------------
SENTRY_DSN=
